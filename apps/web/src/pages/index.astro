---
import Layout from '../layouts/Layout.astro';
import PhotoImage from '../components/PhotoImage.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import { data, ordered, url, photoUrl } from '../lib/content';
const cover =
  data.photos.find((p) => p.id === data.settings.homeCoverId) ?? ordered[0];
const featured = ordered.filter((p) => p.featured).slice(0, 6);
const collections = data.collections
  .toSorted((a, b) => a.order - b.order)
  .slice(0, 3);
const stories = data.journals
  .toSorted((a, b) => b.date.localeCompare(a.date))
  .slice(0, 2);
---

<Layout>
  <section class="hero">
    <div class="hero-label">
      <span>A PHOTOGRAPHIC ARCHIVE</span>
      <span>BY CASTORRISE</span>
    </div>
    {cover ? (
      <a
        href={photoUrl(cover.id)}
        data-photo={cover.id}
        class="hero-image"
        aria-label={`浏览封面：${cover.title}`}
      >
        <PhotoImage photo={cover} eager sizes="100vw" />
      </a>
    ) : (
      <div class="empty hero-image">第一张照片，等待被看见。</div>
    )}
    <div class="hero-bottom">
      <div>
        <p class="eyebrow">CASTORRISE GALLERY</p>
        <h1>Light, held still.</h1>
        <p class="manifesto">{data.settings.manifesto}</p>
      </div>
      <div class="hero-meta">
        {cover && (
          <>
            <span>{cover.title}</span>
            <span>{cover.location.city ?? ''}</span>
          </>
        )}
        <a class="scroll-cue" href="#featured">
          Scroll to explore ↓
        </a>
      </div>
    </div>
  </section>
  <section class="section" id="featured">
    <div class="section-heading">
      <div>
        <p class="eyebrow">01 / SELECTED PHOTOGRAPHS</p>
        <h2>
          Featured works<span>精选作品</span>
        </h2>
      </div>
      <a class="text-link" href={url('gallery/')}>
        View all works ↗
      </a>
    </div>
    <PhotoGrid photos={featured} />
  </section>
  <section class="section collections-home">
    <div class="section-heading">
      <div>
        <p class="eyebrow">02 / VISUAL CHAPTERS</p>
        <h2>
          Collections<span>摄影专题</span>
        </h2>
      </div>
      <a class="text-link" href={url('collections/')}>
        All collections ↗
      </a>
    </div>
    <div class="collection-list">
      {collections.map((c, i) => {
        const p =
          data.photos.find((p) => p.id === c.coverId) ??
          data.photos.find((p) => c.photoIds.includes(p.id));
        return (
          <a class="collection-row" href={url(`collections/${c.id}/`)}>
            <span class="index">0{i + 1}</span>
            <div>
              <h3>{c.englishName || c.name}</h3>
              <p>
                {c.name} · {c.photoIds.length} photographs
              </p>
            </div>
            {p && (
              <PhotoImage photo={p} sizes="(max-width:650px) 110px, 240px" />
            )}
            <span class="row-arrow">↗</span>
          </a>
        );
      })}
    </div>
  </section>
  <section class="section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">03 / FIELD NOTES</p>
        <h2>
          Latest stories<span>摄影手记</span>
        </h2>
      </div>
      <a class="text-link" href={url('journal/')}>
        Open journal ↗
      </a>
    </div>
    {stories.length ? (
      <div class="story-grid">
        {stories.map((j) => {
          const p = data.photos.find((p) => p.id === j.coverId);
          return (
            <a class="story-card" href={url(`journal/${j.id}/`)}>
              {p && <PhotoImage photo={p} />}
              <p class="eyebrow">
                {j.date.slice(0, 10)} / {j.place}
              </p>
              <h3>{j.title}</h3>
              <p>{j.subtitle}</p>
            </a>
          );
        })}
      </div>
    ) : (
      <p class="quiet-empty">照片之外的文字，留给下一段旅程。</p>
    )}
  </section>
  <section class="explore">
    <p class="eyebrow">EVERY FRAME, A FRAGMENT</p>
    <h2>Take a closer look.</h2>
    <a href={url('gallery/')} class="outline-link">
      Explore gallery <span>↗</span>
    </a>
  </section>
</Layout>
