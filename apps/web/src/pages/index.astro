---
import Layout from '../layouts/Layout.astro';
import PhotoImage from '../components/PhotoImage.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import { pageContent } from '../lib/content';
const { data, ordered, url, photoUrl, t } = pageContent(Astro.url.pathname);
const cover =
  data.photos.find((p) => p.id === data.settings.homeCoverId) ?? ordered[0];
const featured = ordered.filter((p) => p.featured).slice(0, 6);
const collections = data.collections
  .toSorted((a, b) => a.order - b.order)
  .slice(0, 3);
const stories = data.journals
  .toSorted((a, b) => b.date.localeCompare(a.date))
  .slice(0, 2);
---

<Layout>
  <section class="hero">
    <div class="hero-label">
      <span>{t.archive}</span>
      <span>
        {t.by} {data.settings.name}
      </span>
    </div>
    {cover ? (
      <a
        href={photoUrl(cover.id)}
        data-photo={cover.id}
        class="hero-image"
        aria-label={`${t.view}: ${cover.title}`}
      >
        <PhotoImage photo={cover} eager sizes="100vw" />
      </a>
    ) : (
      <div class="empty hero-image">{t.firstPhoto}</div>
    )}
    <div class="hero-bottom">
      <div>
        <p class="eyebrow">{t.photography}</p>
        <h1>{t.heroTitle}</h1>
        <p class="manifesto">{data.settings.manifesto}</p>
      </div>
      <div class="hero-meta">
        {cover && (
          <>
            <span>{cover.title}</span>
            <span>{cover.location.city ?? ''}</span>
          </>
        )}
        <a class="scroll-cue" href="#featured">
          {t.scroll} ↓
        </a>
      </div>
    </div>
  </section>
  <section class="section" id="featured">
    <div class="section-heading">
      <div>
        <p class="eyebrow">01 / {t.selected}</p>
        <h2>
          {t.featured}
          <span>{t.selected}</span>
        </h2>
      </div>
      <a class="text-link" href={url('gallery/')}>
        {t.viewAll} ↗
      </a>
    </div>
    <PhotoGrid photos={featured} />
  </section>
  <section class="section collections-home">
    <div class="section-heading">
      <div>
        <p class="eyebrow">02 / {t.chapters}</p>
        <h2>
          {t.collections}
          <span>{t.chapters}</span>
        </h2>
      </div>
      <a class="text-link" href={url('collections/')}>
        {t.allCollections} ↗
      </a>
    </div>
    <div class="collection-list">
      {collections.map((c, i) => {
        const p =
          data.photos.find((p) => p.id === c.coverId) ??
          data.photos.find((p) => c.photoIds.includes(p.id));
        return (
          <a class="collection-row" href={url(`collections/${c.id}/`)}>
            <span class="index">0{i + 1}</span>
            <div>
              <h3>{c.name}</h3>
              <p>
                {c.name} · {c.photoIds.length} {t.photographs}
              </p>
            </div>
            {p && (
              <PhotoImage photo={p} sizes="(max-width:650px) 110px, 240px" />
            )}
            <span class="row-arrow">↗</span>
          </a>
        );
      })}
    </div>
  </section>
  <section class="section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">03 / {t.fieldNotes}</p>
        <h2>
          {t.latest}
          <span>{t.fieldNotes}</span>
        </h2>
      </div>
      <a class="text-link" href={url('journal/')}>
        {t.openJournal} ↗
      </a>
    </div>
    {stories.length ? (
      <div class="story-grid">
        {stories.map((j) => {
          const p = data.photos.find((p) => p.id === j.coverId);
          return (
            <a class="story-card" href={url(`journal/${j.id}/`)}>
              {p && <PhotoImage photo={p} />}
              <p class="eyebrow">
                {j.date.slice(0, 10)} / {j.place}
              </p>
              <h3>{j.title}</h3>
              <p>{j.subtitle}</p>
            </a>
          );
        })}
      </div>
    ) : (
      <p class="quiet-empty">{t.storiesEmpty}</p>
    )}
  </section>
  <section class="explore">
    <p class="eyebrow">{t.fragment}</p>
    <h2>{t.closer}</h2>
    <a href={url('gallery/')} class="outline-link">
      {t.explore} <span>↗</span>
    </a>
  </section>
</Layout>
