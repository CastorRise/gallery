---
import Layout from '../layouts/Layout.astro';
import { imageUrl, pageContent } from '../lib/content';
const { data, photoUrl, t } = pageContent(Astro.url.pathname);
const photos = data.photos
  .filter(
    (p) =>
      p.location.latitude !== undefined && p.location.longitude !== undefined,
  )
  .map((p) => ({
    id: p.id,
    title: p.title,
    city: p.location.city,
    latitude: p.location.latitude,
    longitude: p.location.longitude,
    privacy: p.location.privacy,
    image: imageUrl(p.variants[0].file),
    url: photoUrl(p.id),
  }));
---

<Layout title={t.map} description={t.mapDescription}>
  <section class="page-intro map-intro">
    <p class="eyebrow">{t.places}</p>
    <h1>
      {t.mapTitle}
      <span>{t.mapIntro}</span>
    </h1>
  </section>
  <section class="map-section">
    <div class="map-controls">
      <label>
        {t.city}
        <select id="map-city">
          <option value="">{t.allCities}</option>
          {[...new Set(photos.map((p) => p.city).filter(Boolean))].map((c) => (
            <option>{c}</option>
          ))}
        </select>
      </label>
      <label>
        {t.collections}
        <select id="map-collection">
          <option value="">{t.allCollections}</option>
          {data.collections.map((c) => (
            <option value={c.id}>{c.name}</option>
          ))}
        </select>
      </label>
      <span id="map-count" role="status"></span>
    </div>
    <div id="photo-map" role="region" aria-label={t.mapLabel}></div>
    <p class="map-note">{t.mapNote}</p>
    <noscript>
      <p>{t.mapJs}</p>
    </noscript>
  </section>
  <script
    id="map-data"
    type="application/json"
    set:html={JSON.stringify({
      photos,
      collections: data.collections.map((c) => ({
        id: c.id,
        photoIds: c.photoIds,
      })),
    }).replace(/</g, '\\u003c')}
  />
  <script>
    import '../scripts/map';
  </script>
</Layout>
