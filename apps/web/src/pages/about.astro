---
import Layout from '../layouts/Layout.astro';
import { data } from '../lib/content';
---

<Layout title="About">
  <section class="page-intro">
    <p class="eyebrow">BEHIND THE FRAME</p>
    <h1>
      About<span>CastorRise</span>
    </h1>
  </section>
  <section class="about-layout">
    <div class="about-copy">
      <h2>{data.settings.manifesto}</h2>
      {data.settings.bio && <p>{data.settings.bio}</p>}
      {data.settings.philosophy && (
        <>
          <p class="eyebrow">PHILOSOPHY</p>
          <p>{data.settings.philosophy}</p>
        </>
      )}
    </div>
    <aside>
      <p class="eyebrow">EQUIPMENT</p>
      <ul class="equipment">
        {data.settings.equipment.map((e) => (
          <li>{e}</li>
        ))}
      </ul>
      <p class="eyebrow">FIND ME ELSEWHERE</p>
      <a href={data.settings.github}>GitHub ↗</a>
      <a href="https://castorrise.github.io/">Personal website ↗</a>
      {data.settings.email && (
        <a href={`mailto:${data.settings.email}`}>{data.settings.email} ↗</a>
      )}
    </aside>
  </section>
</Layout>
