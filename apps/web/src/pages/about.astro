---
import Layout from '../layouts/Layout.astro';
import { pageContent } from '../lib/content';
const { data, t } = pageContent(Astro.url.pathname);
---

<Layout title={t.about}>
  <section class="page-intro">
    <p class="eyebrow">{t.behind}</p>
    <h1>
      {t.about}
      <span>CastorRise</span>
    </h1>
  </section>
  <section class="about-layout">
    <div class="about-copy">
      <h2>{data.settings.manifesto}</h2>
      {data.settings.bio && <p>{data.settings.bio}</p>}
      {data.settings.philosophy && (
        <>
          <p class="eyebrow">{t.philosophy}</p>
          <p>{data.settings.philosophy}</p>
        </>
      )}
    </div>
    <aside>
      <p class="eyebrow">{t.equipment}</p>
      <ul class="equipment">
        {data.settings.equipment.map((e) => (
          <li>{e}</li>
        ))}
      </ul>
      <p class="eyebrow">{t.elsewhere}</p>
      <a href={data.settings.github}>GitHub ↗</a>
      <a href="https://castorrise.github.io/">{t.website} ↗</a>
      {data.settings.email && (
        <a href={`mailto:${data.settings.email}`}>{data.settings.email} ↗</a>
      )}
    </aside>
  </section>
</Layout>
