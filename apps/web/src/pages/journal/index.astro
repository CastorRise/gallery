---
import Layout from '../../layouts/Layout.astro';
import PhotoImage from '../../components/PhotoImage.astro';
import { pageContent } from '../../lib/content';
const { data, url, t } = pageContent(Astro.url.pathname);
---

<Layout title={t.journal}>
  <section class="page-intro">
    <p class="eyebrow">{t.notesStories}</p>
    <h1>
      {t.journal}
      <span>{t.journalIntro}</span>
    </h1>
  </section>
  <section class="section top-none">
    <div class="story-grid">
      {data.journals
        .toSorted((a, b) => b.date.localeCompare(a.date))
        .map((j) => {
          const p = data.photos.find((p) => p.id === j.coverId);
          return (
            <a class="story-card" href={url(`journal/${j.id}/`)}>
              {p && <PhotoImage photo={p} />}
              <p class="eyebrow">
                {j.date.slice(0, 10)} / {j.place}
              </p>
              <h2>{j.title}</h2>
              <p>{j.subtitle}</p>
            </a>
          );
        })}
    </div>
    {!data.journals.length && <p class="quiet-empty">{t.journalEmpty}</p>}
  </section>
</Layout>
