---
import Layout from '../layouts/Layout.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import { pageContent } from '../lib/content';
const { data, ordered, t } = pageContent(Astro.url.pathname);
const cities = [
  ...new Set(data.photos.map((p) => p.location.city).filter(Boolean)),
];
---

<Layout title={t.gallery} description={t.galleryDescription}>
  <section class="page-intro">
    <p class="eyebrow">{t.completeArchive}</p>
    <div class="intro-row">
      <h1>
        {t.gallery}
        <span>{t.fragment}</span>
      </h1>
      <p>
        <span id="result-count">{data.photos.length}</span> {t.photographs}
      </p>
    </div>
  </section>
  <section class="gallery-section">
    <form id="gallery-controls" class="gallery-controls" role="search">
      <label class="search-field">
        <span class="sr-only">{t.search}</span>
        <input type="search" id="gallery-search" placeholder={t.search} />
      </label>
      <label>
        <span class="sr-only">{t.category}</span>
        <select id="category-filter">
          <option value="">{t.allCategories}</option>
          {data.categories
            .toSorted((a, b) => a.order - b.order)
            .map((c) => (
              <option value={c.id}>{c.name}</option>
            ))}
        </select>
      </label>
      <label>
        <span class="sr-only">{t.location}</span>
        <select id="city-filter">
          <option value="">{t.allLocations}</option>
          {cities.map((city) => (
            <option>{city}</option>
          ))}
        </select>
      </label>
      <label>
        <span class="sr-only">{t.sort}</span>
        <select id="sort-filter">
          <option value="order">{t.curated}</option>
          <option value="taken">{t.takenSort}</option>
          <option value="published">{t.publishedSort}</option>
        </select>
      </label>
    </form>
    <PhotoGrid photos={ordered} filterable />
    <p id="gallery-empty" class="quiet-empty" hidden>
      {t.noResults}
    </p>
    <noscript>
      <p>{t.filterJs}</p>
    </noscript>
  </section>
  <script>
    import '../scripts/gallery';
  </script>
</Layout>
