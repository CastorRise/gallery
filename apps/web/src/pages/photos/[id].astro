---
import { exifKeys } from '../../lib/i18n';
import Layout from '../../layouts/Layout.astro';
import PhotoImage from '../../components/PhotoImage.astro';
import {
  imageUrl,
  largest,
  data as sourceData,
  pageContent,
} from '../../lib/content';
const { data, url, categoryName, t } = pageContent(Astro.url.pathname);
export function getStaticPaths() {
  return sourceData.photos.map((photo) => ({
    params: { id: photo.id },
    props: { photo },
  }));
}
const p = data.photos.find((p) => p.id === Astro.props.photo.id)!;
const collections = data.collections.filter((c) => c.photoIds.includes(p.id));
const exif = Object.entries(p.exif).filter(([, value]) => value);
---

<Layout
  title={p.title}
  description={p.description || p.title}
  image={new URL(imageUrl(largest(p).file), Astro.site).href}
>
  <section class="detail">
    <a href={url('gallery/')} class="back-link">
      ← {t.gallery}
    </a>
    <a
      class="detail-image"
      data-photo={p.id}
      href={imageUrl(largest(p).file)}
      aria-label={`${t.fullscreen}: ${p.title}`}
    >
      <PhotoImage photo={p} eager sizes="(max-width: 900px) 100vw, 90vw" />
    </a>
    <div class="detail-copy">
      <div>
        <p class="eyebrow">{categoryName(p.categoryId)}</p>
        <h1>{p.title}</h1>
        {p.description && <p class="description">{p.description}</p>}
        <div class="detail-tags">
          {p.takenAt && <span>{p.takenAt}</span>}
          {p.location.label && <span>{p.location.label}</span>}
        </div>
        {collections.length > 0 && (
          <div class="detail-collections">
            <p class="eyebrow">{t.inCollections}</p>
            {collections.map((c) => (
              <a href={url(`collections/${c.id}/`)}>{c.name} ↗</a>
            ))}
          </div>
        )}
      </div>
      <section class="exif-section" aria-labelledby="exif-heading">
        <h2 id="exif-heading" class="eyebrow">
          {t.exif}
        </h2>
        {exif.length > 0 ? (
          <dl class="exif">
            {exifKeys
              .filter((key) => p.exif[key])
              .map((key) => (
                <div>
                  <dt>{t[key]}</dt>
                  <dd>{p.exif[key]}</dd>
                </div>
              ))}
          </dl>
        ) : (
          <p class="exif-empty">{t.noExif}</p>
        )}
      </section>
    </div>
  </section>
</Layout>
