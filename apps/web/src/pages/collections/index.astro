---
import Layout from '../../layouts/Layout.astro';
import PhotoImage from '../../components/PhotoImage.astro';
import { pageContent } from '../../lib/content';
const { data, url, t } = pageContent(Astro.url.pathname);
---

<Layout title={t.collections}>
  <section class="page-intro">
    <p class="eyebrow">{t.chapters}</p>
    <h1>
      {t.collections}
      <span>{t.collectionIntro}</span>
    </h1>
  </section>
  <section class="section top-none">
    <div class="collection-covers">
      {data.collections
        .toSorted((a, b) => a.order - b.order)
        .map((c) => {
          const p =
            data.photos.find((p) => p.id === c.coverId) ??
            data.photos.find((p) => c.photoIds.includes(p.id));
          return (
            <a class="collection-cover" href={url(`collections/${c.id}/`)}>
              {p && (
                <PhotoImage photo={p} sizes="(max-width:650px) 100vw, 50vw" />
              )}
              <div>
                <span class="eyebrow">
                  {c.photoIds.length} {t.photographs}
                </span>
                <h2>{c.name}</h2>
                <p>{c.name}</p>
              </div>
            </a>
          );
        })}
    </div>
    {!data.collections.length && (
      <p class="quiet-empty">{t.collectionsEmpty}</p>
    )}
  </section>
</Layout>
