---
import Layout from '../../layouts/Layout.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import { data as sourceData, pageContent } from '../../lib/content';
const { data, url, t } = pageContent(Astro.url.pathname);
export function getStaticPaths() {
  return sourceData.collections.map((collection) => ({
    params: { id: collection.id },
    props: { collection },
  }));
}
const c = data.collections.find((c) => c.id === Astro.props.collection.id)!;
const photos = c.photoIds
  .map((id) => data.photos.find((p) => p.id === id))
  .filter((p) => p !== undefined);
---

<Layout title={c.name} description={c.description || c.name}>
  <section class="page-intro">
    <a href={url('collections/')} class="back-link">
      ← {t.collections}
    </a>
    <p class="eyebrow">
      {c.photoIds.length} {t.photographs}
    </p>
    <h1>
      {c.name}
      <span>{c.name}</span>
    </h1>
    {c.description && <p class="intro-description">{c.description}</p>}
  </section>
  <section class="gallery-section">
    <PhotoGrid photos={photos} />
  </section>
</Layout>
