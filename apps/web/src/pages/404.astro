---
import Layout from '../layouts/Layout.astro';
import { pageContent } from '../lib/content';
const { url, t } = pageContent(Astro.url.pathname);
---

<Layout title={t.notFound}>
  <section class="explore">
    <p class="eyebrow">404 / {t.outOfFrame}</p>
    <h1>{t.missingFrame}</h1>
    <a class="outline-link" href={url('gallery/')}>
      {t.backGallery} ↗
    </a>
  </section>
</Layout>
