---
import { pageContent, imageUrl, largest } from '../lib/content';
const { data, photoUrl, url, t } = pageContent(Astro.url.pathname);
const payload = data.photos.map((p) => ({
  id: p.id,
  title: p.title,
  description: p.description,
  exif: p.exif,
  location: p.location,
  src: imageUrl(largest(p).file),
  url: photoUrl(p.id),
  collections: data.collections
    .filter((c) => c.photoIds.includes(p.id))
    .map((c) => ({ name: c.name, url: url(`collections/${c.id}/`) })),
}));
---

<dialog id="lightbox" aria-label={t.viewer}>
  <div class="viewer-toolbar">
    <span id="viewer-count"></span>
    <div>
      <button id="viewer-info" aria-label={t.viewInfo} aria-pressed="false">
        {t.info}
      </button>
      <button id="viewer-zoom" aria-label={t.zoomPhoto} aria-pressed="false">
        {t.zoom} +
      </button>
      <button id="viewer-close" aria-label={t.closeViewer}>
        {t.close} ×
      </button>
    </div>
  </div>
  <div class="viewer-stage">
    <p id="viewer-loading" role="status">
      {t.loading}
    </p>
    <img id="viewer-image" alt="" />
    <button id="viewer-prev" class="viewer-arrow prev" aria-label={t.previous}>
      ←
    </button>
    <button id="viewer-next" class="viewer-arrow next" aria-label={t.next}>
      →
    </button>
  </div>
  <div class="viewer-footer">
    <h2 id="viewer-title"></h2>
    <a id="viewer-detail">{t.detail} ↗</a>
  </div>
  <aside id="viewer-panel" hidden></aside>
</dialog>
<script
  type="application/json"
  id="viewer-data"
  set:html={JSON.stringify(payload).replace(/</g, '\\u003c')}
/>
<script>
  import '../scripts/viewer';
</script>
